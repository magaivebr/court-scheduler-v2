NODE_ENV=development
HOST=127.0.0.1
PORT=4318
PUBLIC_ORIGIN=http://127.0.0.1:4318
DATA_DIR=.data
BOOKING_MODE=rehearsal
LIVE_BOOKING_ENABLED=false
MAX_ACCOUNTS=30
MAX_CONCURRENT_WORKERS=30
BROWSER_HEADLESS=true
# Optional locally: BROWSER_CHANNEL=msedge
# Production requires random base64 SESSION_ENCRYPTION_KEY (32 bytes).
# Run node scripts/configure.mjs --origin https://your-host.example
# SCHEDULER_DOMAIN=your-host.example
# PROVIDER_IDENTITY_SELECTOR and PROVIDER_IDENTITY_ATTRIBUTE need verified site evidence.
